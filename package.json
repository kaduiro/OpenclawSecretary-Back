{
  "name": "openclaw-secretary-back",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/api-server.js",
    "start:gateway": "node src/gateway-server.js",
    "start:bootstrap": "node src/auth-bootstrap-server.js",
    "dev": "node --watch src/api-server.js",
    "migrate": "node tools/migrate.mjs",
    "test": "node --test",
    "check:openapi": "node tools/validate-openapi.mjs",
    "check:routes": "node tools/check-route-coverage.mjs",
    "check:review": "node tools/check-review-register.mjs",
    "check": "npm run test && npm run check:openapi && npm run check:routes && npm run check:review"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "1.11.2",
    "@google-cloud/kms": "^5.3.0",
    "@google-cloud/secret-manager": "^6.1.1",
    "@google-cloud/tasks": "^6.2.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "express": "^5.1.0",
    "google-auth-library": "^10.2.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "supertest": "^7.1.1",
    "yaml": "^2.8.0"
  }
}
